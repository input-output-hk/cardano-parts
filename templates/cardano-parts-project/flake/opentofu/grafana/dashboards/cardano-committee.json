      "targets": [
        {
          "editorMode": "code",
          "expr": "count by (environment) (max without (instance, job) (cardano_cc_member_seconds_until_expiration{environment=~\"$environment\"}) > 604800 <= 2592000) or (sum by (environment) (max without (instance, job) (cardano_cc_member_count{environment=~\"$environment\"})) * 0)",
