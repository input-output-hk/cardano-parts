    {
      "description": "Max age of cardano-committee.prom per environment (environment joined from cardano_cc_* by instance, since the mtime series has none). >5400s pages via cardano_cc_metrics_stale.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 5400
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 0
      },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max by (environment) ((time() - node_textfile_mtime_seconds{file=~\".*/cardano-committee.prom\",instance=~\"$instance\"}) * on (instance) group_left (environment) group by (instance, environment) (cardano_cc_member_count{environment=~\"$environment\"}))",
          "legendFormat": "{{environment}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Collector age (max)",
      "type": "stat"
    },
    {
      "description": "One row per constitutional-committee member (select a single environment). Time to expiry, ledger state, hot-key authorisation status and next-epoch change. Colours mirror alerts/cardano-committee.nix-import (page/warn conditions).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text"
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time to expiry"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "gradient",
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red"
                    },
                    {
                      "color": "yellow",
                      "value": 604800
                    },
                    {
                      "color": "green",
                      "value": 2592000
                    }
                  ]
                }
              },
              {
                "id": "custom.filterable",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "Active": {
                        "color": "green",
                        "index": 0,
                        "text": "Active"
                      },
                      "Expired": {
                        "color": "red",
                        "index": 1,
                        "text": "Expired"
                      },
                      "Unrecognized": {
                        "color": "orange",
                        "index": 2,
                        "text": "Unrecognized"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "gradient",
                  "type": "color-background"
                }
              },
              {
                "id": "custom.filterable",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Hot key auth status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "MemberAuthorized": {
                        "color": "green",
                        "index": 0,
                        "text": "Authorized"
                      },
                      "MemberNotAuthorized": {
                        "color": "red",
                        "index": 1,
                        "text": "Not authorized"
                      },
                      "MemberResigned": {
                        "color": "red",
                        "index": 2,
                        "text": "Resigned"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "gradient",
                  "type": "color-background"
                }
              },
              {
                "id": "custom.filterable",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Next epoch change"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "NoChangeExpected": {
                        "color": "green",
                        "index": 0,
                        "text": "No change"
                      },
                      "TermAdjusted": {
                        "color": "yellow",
                        "index": 3,
                        "text": "Term adjusted"
                      },
                      "ToBeExpired": {
                        "color": "red",
                        "index": 1,
                        "text": "To be expired"
                      },
                      "ToBeRemoved": {
                        "color": "red",
                        "index": 2,
                        "text": "To be removed"
