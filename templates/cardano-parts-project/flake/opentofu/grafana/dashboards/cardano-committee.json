      "targets": [
        {
          "editorMode": "code",
          "expr": "max without (instance, job) (cardano_cc_member_seconds_until_expiration{environment=~\"$environment\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "EXPIRY"
        },
        {
          "editorMode": "code",
          "expr": "max without (instance, job) (cardano_cc_member_state{environment=~\"$environment\"}) == 1",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "STATE"
        },
        {
          "editorMode": "code",
          "expr": "max without (instance, job) (cardano_cc_member_hot_cred_status{environment=~\"$environment\"}) == 1",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "HOTKEY"
        },
        {
          "editorMode": "code",
          "expr": "max without (instance, job) (cardano_cc_member_next_epoch_change{environment=~\"$environment\"}) == 1",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "CHANGE"
        }
      ],
      "title": "Committee members",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "cold_credential",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^cold_credential$|^state$|^status$|^change$|^Value #EXPIRY$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "Value #EXPIRY": 4,
              "change": 3,
              "cold_credential": 0,
              "state": 1,
              "status": 2
            },
            "renameByName": {
              "Value #EXPIRY": "Time to expiry",
              "change": "Next epoch change",
              "cold_credential": "CC cold credential",
              "state": "State",
              "status": "Hot key auth status"
            }
          }
        }
      ],
      "type": "table"
    },
