        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max without (instance, job) (cardano_cc_member_count{environment=~\"$environment\"})",
          "legendFormat": "{{environment}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Committee members",
      "type": "stat"
    },
