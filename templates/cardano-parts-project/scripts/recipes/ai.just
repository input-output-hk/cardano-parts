# AI agent helper recipes.
#
# Imported optionally via `import?` in the main Justfile, so this functionality
# can be opted out of simply by removing this file. Splitting it out also keeps
# diffing and patching the main repo Justfile against the template easier.

# Directory holding the shared SSH ControlMaster sockets + AI ssh config used by
# `just ai-ssh*`. Set AI_SSH_DIR to a path your AI agent's sandbox can read
# (e.g. a mounted share); defaults to a repo-local `.ssh-ai/` dir, which is
# portable across SREs as long as the agent can see the repo working tree.
aiSshDir := trim_end_match(env_var_or_default("AI_SSH_DIR", justfile_directory() / ".ssh-ai"), "/")

# How long an opened master is kept alive after its backgrounding process exits.
aiSshPersist := env_var_or_default("AI_SSH_PERSIST", "2h")

# Open shared SSH ControlMaster session(s) for an AI agent (space/comma separated host names or regexes)
ai-ssh +HOSTNAMES:
  #!/usr/bin/env bash
  set -euo pipefail
  # Args are regexes (may contain '*'), iterated via unquoted word-splitting
  # below. Disable globbing so a pattern like 'leios.*' is not pathname-expanded
  # against the cwd (e.g. matching local leios.db / leios.full.tar.zst files).
  set -f

  if [ ! -f .ssh_config ]; then
    echo "No .ssh_config found — run \`just save-ssh-config\` first." >&2
    exit 1
  fi

  dir={{ quote(aiSshDir) }}
  cfg="$dir/ssh_config_ai"
  mkdir -p "$dir"
  chmod 700 "$dir"

  # (Re)generate the agent ssh config: a top `Host *` block enabling multiplexing
  # with sockets under the shared dir (first match wins for ControlMaster/Path/Persist),
  # followed by the tofu-generated host blocks. Absolute ControlPath so it resolves
  # identically from the agent sandbox (which may have a different $HOME and cwd).
  {
    echo "# Generated by \`just ai-ssh\` — shared SSH multiplexing for an AI agent."
    echo "# The agent uses these sockets with: ssh -F <this file> <host>"
    echo "Host *"
    echo "  ControlMaster auto"
    echo "  ControlPath $dir/cm-%n"
    echo "  ControlPersist {{ aiSshPersist }}"
    echo
    cat .ssh_config
  } > "$cfg"
  chmod 600 "$cfg"

  # Expand each argument as a regex against the host names in .ssh_config. A
  # literal host name matches itself; patterns like 'leios.-(bp|rel).*' fan out
  # to every matching host.
  hosts=""
  for pat in $(echo "$@" | tr ',' ' '); do
    matched=$(just ssh-list name "$pat" || true)
    if [ -n "$matched" ]; then
      hosts="$hosts $matched"
    else
      echo "  no host matches: $pat" >&2
    fi
  done
  hosts=$(echo $hosts | tr ' ' '\n' | sort -u | tr '\n' ' ')

  if [ -z "${hosts// }" ]; then
    echo "No hosts matched the given pattern(s)." >&2
    exit 1
  fi

  for h in $hosts; do
    if ssh -F "$cfg" -O check "$h" >/dev/null 2>&1; then
      echo "  already open: $h"
    elif ssh -F "$cfg" -o LogLevel=ERROR -fN "$h"; then
      echo "  opened:       $h"
    else
      echo "  FAILED:       $h" >&2
    fi
  done

  echo
  echo "Agent config : $cfg"
  echo "Socket dir   : $dir   (cm-* sockets)"
  echo "Give your AI agent read access to that dir, then it connects via:"
  echo "  ssh -F $cfg <host> <cmd>"

# List the shared AI ControlMaster sockets and whether each is live
ai-ssh-list:
  #!/usr/bin/env bash
  set -euo pipefail
  dir={{ quote(aiSshDir) }}
  shopt -s nullglob
  socks=("$dir"/cm-*)
  if [ ${#socks[@]} -eq 0 ]; then
    echo "No AI ssh masters in $dir"
    exit 0
  fi
  for sock in "${socks[@]}"; do
    [ -S "$sock" ] || continue
    if ssh -S "$sock" -O check placeholder >/dev/null 2>&1; then
      echo "LIVE   $sock"
    else
      echo "stale  $sock"
    fi
  done

# Close shared AI ControlMaster sessions (all, or the named hosts)
ai-ssh-close *HOSTNAMES:
  #!/usr/bin/env bash
  set -euo pipefail
  dir={{ quote(aiSshDir) }}
  cfg="$dir/ssh_config_ai"
  hosts=$(echo "$@" | tr ',' ' ')

  if [ -n "$hosts" ]; then
    for h in $hosts; do
      if ssh -F "$cfg" -O exit "$h" >/dev/null 2>&1; then
        echo "  closed: $h"
      else
        echo "  not open: $h"
      fi
    done
  else
    shopt -s nullglob
    for sock in "$dir"/cm-*; do
      ssh -S "$sock" -O exit placeholder >/dev/null 2>&1 || true
      rm -f "$sock"
      echo "  closed socket: $sock"
    done
  fi

# Register this repo's Grafana MCP server (scripts/ai/grafana-mcp) with Claude Code
ai-grafana-mcp:
  #!/usr/bin/env bash
  set -euo pipefail
  wrap="{{justfile_directory()}}/scripts/ai/grafana-mcp"
  [ -x "$wrap" ] || { echo "Launcher not found/executable: $wrap" >&2; exit 1; }
  command -v claude >/dev/null || { echo "The 'claude' CLI is not on PATH." >&2; exit 1; }

  # Invoke via `bash` so it works regardless of whether /usr/bin/env is present.
  if claude mcp get grafana >/dev/null 2>&1; then
    echo "grafana MCP already registered. To refresh: claude mcp remove grafana -s user && just ai-grafana-mcp"
    exit 0
  fi
  claude mcp add --scope user grafana -- bash "$wrap"
  echo "Registered. Tools (mcp__grafana__*) load on next Claude Code session; verify: claude mcp get grafana"
